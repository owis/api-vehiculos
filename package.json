{
  "name": "bit-api-vehiculos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de consulta vehicular de bit — resolución de patentes (PRT + caché) sin persistencia de negocio",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --ext js,json --exec \"node src/index.js\"",
    "migrate": "node scripts/migrate.js",
    "ingest:prt": "node scripts/ingest-prt.js",
    "seed:prt": "node scripts/seed-prt-diccionarios.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mysql2": "^3.10.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
